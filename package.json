{
  "name": "anim-engine",
  "version": "0.7.1",
  "private": false,
  "description": "JavaScript library for animating numbers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LukeCarlThompson/anim-engine.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt",
    "SKILL.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "npm run lint && npm run test:watch && vite",
    "build": "npm run lint && npm run test && npm run build:lib",
    "build:lib": "tsc && vite build",
    "preview": "vite preview",
    "check:types": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "npm run lint && npm run test && storybook build",
    "prepublishOnly": "npm run build",
    "bench": "npm run build:lib && node src/benchmarks/stage-package.mjs && vitest bench src/benchmarks/ --run --reporter=verbose",
    "format": "oxfmt src docs",
    "format:check": "oxfmt --check src docs",
    "fmt": "oxfmt src docs"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "^0.5.3",
    "astro": "^7.4.11",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/html": "10.6.7",
    "@storybook/html-vite": "10.6.7",
    "@typescript/typescript6": "^6.0.2",
    "gsap": "3.15.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier-plugin-astro": "^1.1.2",
    "storybook": "10.6.7",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.1.0"
  }
}
